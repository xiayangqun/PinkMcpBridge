{
    "name": "pink-mcp-bridge",
    "displayName": "pink_mcp_bridge",
    "description": "把当前 Cocos 项目的 cocos-cli MCP 服务桥接给 ZCode / Codex：自动拉起服务、写入对方 MCP 配置，端口可选。",
    "version": "0.1.0",
    "publisher": "local",
    "license": "MIT",
    "private": true,
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./src/extension.js",
    "scripts": {
        "package": "vsce package --no-dependencies --allow-missing-repository",
        "build": "bash scripts/build.sh",
        "build:install": "bash scripts/build.sh --install"
    },
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "pinkMcpBridge",
                    "title": "PinkMcpBridge",
                    "icon": "media/bridge.svg"
                }
            ]
        },
        "views": {
            "pinkMcpBridge": [
                {
                    "type": "webview",
                    "id": "pinkMcpBridge.panelView",
                    "name": "MCP 桥接面板",
                    "retainContextWhenHidden": true
                }
            ]
        },
        "commands": [
            {
                "command": "pinkMcpBridge.openPanel",
                "title": "pink_mcp_bridge：打开配置面板"
            },
            {
                "command": "pinkMcpBridge.ensureServer",
                "title": "pink_mcp_bridge：启动 MCP 服务"
            },
            {
                "command": "pinkMcpBridge.stopServer",
                "title": "pink_mcp_bridge：停止 MCP 服务"
            },
            {
                "command": "pinkMcpBridge.applyConfigs",
                "title": "pink_mcp_bridge：应用配置（写入 ZCode / Codex）"
            },
            {
                "command": "pinkMcpBridge.removeConfigs",
                "title": "pink_mcp_bridge：移除 ZCode / Codex 配置"
            }
        ],
        "configuration": {
            "title": "pink_mcp_bridge",
            "properties": {
                "pinkMcpBridge.port": {
                    "type": "number",
                    "default": 9630,
                    "minimum": 1,
                    "maximum": 65535,
                    "description": "cocos-cli MCP 服务的端口。可在工作区级覆盖，实现每个项目一个端口。"
                },
                "pinkMcpBridge.cliPath": {
                    "type": "string",
                    "default": "",
                    "description": "cocos-cli 根目录（含 dist/cli.js）。留空自动探测：项目 cocos.version 匹配 ~/Library/Application Support/cocos-default/ 下的版本。"
                },
                "pinkMcpBridge.nodePath": {
                    "type": "string",
                    "default": "",
                    "description": "运行 bridge 与服务的 node 绝对路径。留空自动探测（which node → nvm 最新版 → Homebrew）。"
                },
                "pinkMcpBridge.codexScope": {
                    "type": "string",
                    "enum": [
                        "project",
                        "global"
                    ],
                    "enumDescriptions": [
                        "写入项目级 <项目>/.codex/config.toml（若 Codex 不支持项目级配置，切回 global）",
                        "写入全局 ~/.codex/config.toml，bridge 从工作目录自动识别项目"
                    ],
                    "default": "project",
                    "description": "Codex 的 MCP 配置写到哪个作用域。"
                },
                "pinkMcpBridge.autoEnsure": {
                    "type": "boolean",
                    "default": true,
                    "description": "PinK 打开 Cocos 项目时自动拉起 MCP 服务。"
                },
                "pinkMcpBridge.autoSyncConfigs": {
                    "type": "boolean",
                    "default": true,
                    "description": "激活时自愈同步配置：插件升级或改端口后自动重写 ZCode / Codex 里的 pink_mcp_bridge 条目。"
                }
            }
        }
    }
}
